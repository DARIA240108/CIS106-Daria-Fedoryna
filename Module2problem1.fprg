    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="qty" type="Real" array="False" size=""/>
            <declare name="pricePerUnit" type="Real" array="False" size=""/>
            <input variable="qty"/>
            <input variable="pricePerUnit"/>
            <assign variable="extendedPrice" expression="qty * pricePerUnit"/>
            <output expression="extendedPrice" newline="True"/>
        </body>
    </function>
</flowgorithm>
