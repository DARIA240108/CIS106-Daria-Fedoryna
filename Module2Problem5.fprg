<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Module2Problem5"/>
        <attribute name="authors" value="daria"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-01 10:36:37 AM"/>
        <attribute name="created" value="ZGFyaWE7RFVGRlk7MjAyNi0wOS0wMTsxMDozMToxNyBBTTsyMTU3"/>
        <attribute name="edited" value="ZGFyaWE7RFVGRlk7MjAyNi0wOS0wMTsxMDozNjozNyBBTTsxOzIyNzI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="itemPrice" type="Real" array="False" size=""/>
            <declare name="discountPercent" type="Real" array="False" size=""/>
            <declare name="discountAmount" type="Real" array="False" size=""/>
            <declare name="discPrice" type="Real" array="False" size=""/>
            <input variable="itemPrice"/>
            <input variable="discountPercent"/>
            <assign variable="discountAmount" expression="itemPrice * discountPercent"/>
            <assign variable="discPrice" expression="itemPrice - discountAmount"/>
            <output expression="discountAmount" newline="True"/>
            <output expression="discPrice" newline="True"/>
        </body>
    </function>
</flowgorithm>
