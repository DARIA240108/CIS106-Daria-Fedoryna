<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="problem3.flowchart"/>
        <attribute name="authors" value="daria"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-02 03:57:22 PM"/>
        <attribute name="created" value="ZGFyaWE7RFVGRlk7MjAyNi0xMC0wMjswMzozNTo1NiBQTTsyMTc0"/>
        <attribute name="edited" value="ZGFyaWE7RFVGRlk7MjAyNi0xMC0wMjswMzo1NzoyMiBQTTsxOzIyNzk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="lastName" type="String" array="False" size=""/>
            <declare name="month" type="String" array="False" size=""/>
            <declare name="sales" type="Real" array="False" size=""/>
            <declare name="nextMonthSales" type="Real" array="False" size=""/>
            <declare name="loopResponse" type="String" array="False" size=""/>
            <assign variable="loopResponse" expression="&quot;y&quot;"/>
            <while expression="loopResponse == &quot;y&quot;">
                <input variable="lastName"/>
                <input variable="month"/>
                <input variable="sales"/>
                <assign variable="nextMonthSales" expression="computeForecast(month, sales)"/>
                <output expression="&quot;Last name: &quot; &amp; lastName" newline="True"/>
                <output expression="&quot;Month: &quot; &amp; month" newline="True"/>
                <output expression="&quot;Next month sales: $&quot; &amp; nextMonthSales" newline="True"/>
                <input variable="loopResponse"/>
            </while>
        </body>
    </function>
    <function name="computeForecast" type="Real" variable="nextMonthSales">
        <parameters>
            <parameter name="month" type="String" array="False"/>
            <parameter name="sales" type="Real" array="False"/>
        </parameters>
        <body>
            <declare name="forecastPercent" type="Real" array="False" size=""/>
            <declare name="nextMonthSales" type="Real" array="False" size=""/>
            <if expression="month == &quot;Jan&quot; or month == &quot;Feb&quot; or month == &quot;Mar&quot;">
                <then>
                    <assign variable="forecastPercent" expression="0.10"/>
                </then>
                <else>
                    <if expression="month == &quot;Apr&quot; or month == &quot;May&quot; or month == &quot;Jun&quot;">
                        <then>
                            <assign variable="forecastPercent" expression="0.15"/>
                        </then>
                        <else>
                            <if expression="month == &quot;Jul&quot; or month == &quot;Aug&quot; or month == &quot;Sep&quot;">
                                <then>
                                    <assign variable="forecastPercent" expression="0.20"/>
                                </then>
                                <else>
                                    <assign variable="forecastPercent" expression="0.25"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="nextMonthSales" expression="sales * (1 + forecastPercent)"/>
        </body>
    </function>
</flowgorithm>
