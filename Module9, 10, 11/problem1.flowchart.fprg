<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="problem1"/>
        <attribute name="authors" value="daria"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-02 03:25:22 PM"/>
        <attribute name="created" value="ZGFyaWE7RFVGRlk7MjAyNi0xMC0wMjswMzowMDoyOSBQTTsyMTY2"/>
        <attribute name="edited" value="ZGFyaWE7RFVGRlk7MjAyNi0xMC0wMjswMzoyNToyMiBQTTsyOzIyNzU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="qty" type="Integer" array="False" size=""/>
            <declare name="price" type="Real" array="False" size=""/>
            <declare name="extendedPrice" type="Real" array="False" size=""/>
            <declare name="totalExtPrice" type="Real" array="False" size=""/>
            <declare name="loopResponse" type="String" array="False" size=""/>
            <assign variable="totalExtPrice" expression="0"/>
            <assign variable="loopResponse" expression="&quot;y&quot;"/>
            <while expression="loopResponse == &quot;y&quot;">
                <input variable="qty"/>
                <input variable="price"/>
                <assign variable="extendedPrice" expression="computeTotal(qty, price)"/>
                <output expression="&quot;Quantity:&quot; &amp; qty" newline="True"/>
                <output expression="&quot;Price: $&quot; &amp; price" newline="True"/>
                <output expression="&quot;Extended price: $&quot; &amp; extendedPrice" newline="True"/>
                <assign variable="totalExtPrice" expression="totalExtPrice + extendedPrice"/>
                <input variable="loopResponse"/>
            </while>
            <output expression="&quot;Total extended price: $&quot; &amp; totalExtPrice" newline="True"/>
        </body>
    </function>
    <function name="computeTotal" type="Real" variable="total">
        <parameters>
            <parameter name="qty" type="Integer" array="False"/>
            <parameter name="price" type="Real" array="False"/>
        </parameters>
        <body>
            <declare name="total" type="Real" array="False" size=""/>
            <declare name="discount" type="Real" array="False" size=""/>
            <assign variable="total" expression="qty * price"/>
            <if expression="total &gt; 10000">
                <then>
                    <assign variable="discount" expression="total * 0.10"/>
                    <assign variable="total" expression="total - discount"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
