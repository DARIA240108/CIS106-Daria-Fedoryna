<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="problem5.flowchart."/>
        <attribute name="authors" value="daria"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-02 05:53:21 PM"/>
        <attribute name="created" value="ZGFyaWE7RFVGRlk7MjAyNi0xMC0wMjswNToxNzowNiBQTTsyMTcx"/>
        <attribute name="edited" value="ZGFyaWE7RFVGRlk7MjAyNi0xMC0wMjswNTo1MzoyMSBQTTsxOzIyNzY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="quantity" type="Integer" array="False" size=""/>
            <declare name="price" type="Real" array="False" size=""/>
            <declare name="discountRate" type="Real" array="False" size=""/>
            <declare name="discountAmount" type="Real" array="False" size=""/>
            <declare name="discountedPrice" type="Real" array="False" size=""/>
            <declare name="loopResponse" type="String" array="False" size=""/>
            <assign variable="loopResponse" expression="&quot;y&quot;"/>
            <while expression="loopResponse == &quot;y&quot;">
                <input variable="quantity"/>
                <input variable="price"/>
                <input variable="discountRate"/>
                <assign variable="discountedPrice" expression="computeDiscount(quantity, price, discountRate)"/>
                <assign variable="discountAmount" expression="quantity * price - discountedPrice"/>
                <output expression="&quot;Quantity: &quot; &amp; quantity" newline="True"/>
                <output expression="&quot;Price : $&quot; &amp; price" newline="True"/>
                <output expression="&quot;Discount amount: $&quot; &amp; discountAmount" newline="True"/>
                <output expression="&quot;Discounted price: $&quot; &amp; discountedPrice" newline="True"/>
                <input variable="loopResponse"/>
            </while>
        </body>
    </function>
    <function name="computeDiscount" type="Real" variable="discountedPrice">
        <parameters>
            <parameter name="quantity" type="Integer" array="False"/>
            <parameter name="price" type="Real" array="False"/>
            <parameter name="discountRate" type="Real" array="False"/>
        </parameters>
        <body>
            <declare name="totalPrice" type="Real" array="False" size=""/>
            <declare name="discountAmount" type="Real" array="False" size=""/>
            <declare name="discountedPrice" type="Real" array="False" size=""/>
            <assign variable="totalPrice" expression="quantity * price"/>
            <assign variable="discountAmount" expression="totalPrice * discountRate"/>
            <assign variable="discountedPrice" expression="totalPrice - discountAmount"/>
        </body>
    </function>
</flowgorithm>
