<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="problem2.flowchart"/>
        <attribute name="authors" value="daria"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-02 03:35:50 PM"/>
        <attribute name="created" value="ZGFyaWE7RFVGRlk7MjAyNi0xMC0wMjswMzoyNjoxOSBQTTsyMTcz"/>
        <attribute name="edited" value="ZGFyaWE7RFVGRlk7MjAyNi0xMC0wMjswMzozNTo1MCBQTTsxOzIyNzY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="lastName" type="String" array="False" size=""/>
            <declare name="hits" type="Integer" array="False" size=""/>
            <declare name="atBats" type="Integer" array="False" size=""/>
            <declare name="battingAverage" type="Real" array="False" size=""/>
            <declare name="count" type="Integer" array="False" size=""/>
            <declare name="loopResponse" type="String" array="False" size=""/>
            <assign variable="count" expression="0"/>
            <assign variable="loopResponse" expression="&quot;y&quot;"/>
            <while expression="loopResponse == &quot;y&quot;">
                <input variable="lastName"/>
                <input variable="hits"/>
                <input variable="atBats"/>
                <assign variable="battingAverage" expression="compBattingAverage(hits, atBats)"/>
                <output expression="&quot;last name: &quot; &amp; lastName" newline="True"/>
                <output expression="&quot;Batting average: &quot; &amp; battingAverage" newline="True"/>
                <assign variable="count" expression="count + 1"/>
                <input variable="loopResponse"/>
            </while>
            <output expression="&quot;Number of players entered: &quot; &amp; count" newline="True"/>
        </body>
    </function>
    <function name="compBattingAverage" type="Real" variable="battingAverage">
        <parameters>
            <parameter name="hits" type="Integer" array="False"/>
            <parameter name="atBats" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="battingAverage" type="Real" array="False" size=""/>
            <assign variable="battingAverage" expression="hits / atBats"/>
        </body>
    </function>
</flowgorithm>
